# ===========================================
# FiveM Bot Ultimate V3 - Environment Variables
# ===========================================

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://fivem:fivem_secret@localhost:3306/fivem_bot_ultimate"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-secret-key-min-32-chars"

# Discord Bot
DISCORD_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_GUILD_ID="your-discord-server-id"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# OpenRouter AI
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"
AI_MODEL="glm-5.3-free"
AI_BASE_URL="https://openrouter.ai/api/v1"

# FiveM Server
FIVEM_SERVER="http://127.0.0.1:30120"
FIVEM_SERVER_NAME="My FiveM Server"

# txAdmin (optional)
TXADMIN_URL="http://127.0.0.1:40120"
TXADMIN_TOKEN="your-txadmin-token"

# Redis (for Socket.IO / caching)
REDIS_URL="redis://localhost:6379"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Node Environment
NODE_ENV="development"
