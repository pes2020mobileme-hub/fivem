FROM node:20-alpine AS base

WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/ai-gateway/package.json ./apps/ai-gateway/
RUN npm ci --workspace=apps/ai-gateway

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build --workspace=apps/ai-gateway

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/ai-gateway/dist ./apps/ai-gateway/dist
COPY --from=builder /app/apps/ai-gateway/package.json ./apps/ai-gateway/

WORKDIR /app/apps/ai-gateway
EXPOSE 3002
CMD ["node", "dist/index.js"]
